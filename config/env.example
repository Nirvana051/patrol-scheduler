# 拷成 config/.env 后填写。config/.env 已被 .gitignore 排除，别提交它。
# 云端（真机）
CX_HOST=https://certaintyx.sg:8443
CX_ROBOT=ntu-dog-00001                # 机器人别名，不是机器人 ID
CX_KEY=cx_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# mock 网关（开发/测试）：把上面三行换成下面三行
# CX_HOST=http://127.0.0.1:18443
# CX_ROBOT=ntu-dog-00001
# CX_KEY=cx_mock0001_000000000000000000000000000000000000000000000000

# 本系统
PS_HOST=127.0.0.1
PS_PORT=8088
PS_DATA_DIR=./data
PS_DB_PATH=./data/scheduler.db

# VLM（也可在网页「设置」里改，设置表优先）
VLM_PROVIDER=mock                     # mock | qwen | openai_compat | anthropic
VLM_BASE_URL=http://127.0.0.1:11434/v1
VLM_MODEL=qwen2.5vl:7b
VLM_API_KEY=
VLM_EXTRA_BODY=                       # JSON 对象，合并进请求体（服务商私有参数）

# 阿里通义千问（DashScope 兼容模式）示例：把上面四行换成
# VLM_PROVIDER=qwen
# VLM_BASE_URL=                        # 留空 = https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_MODEL=qwen3.5-flash              # 图片被拒就换 qwen3-vl-plus / qwen-vl-max
# VLM_API_KEY=sk-xxxxxxxx              # DashScope 密钥；非流式调用会自动带 enable_thinking:false
ANTHROPIC_API_KEY=

# TTS
TTS_ENGINE=edge                       # edge | command | none
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_SINKS=browser                     # 逗号分隔：browser,local,http,webhook
TTS_AUDIO_SERVER_URL=                 # 机器狗/现场 PC 上的 audio_server，如 http://192.168.0.122:5566
TTS_AUDIO_SERVER_TOKEN=
TTS_WEBHOOK_URL=

# 抓图源：rtsp（真机）| synthetic（mock/无相机）| file:<path>
SNAPSHOT_SOURCE=synthetic

# 抓帧体检（只对 rtsp/hls 这类 ffmpeg 抓真实流的源生效）
# 接入直播流时可能正好抓到「还没收敛」的画面 —— 一条条上下恒定的竖带。ffmpeg 这时
# **退出码仍是 0**、图片照样输出，只在 stderr 里报解码错误，所以必须另外检查。
# 体检不合格会自动重抓；重抓到底仍不合格就跳过判读（不拿糊图问模型、也不白花一次付费调用），
# 图仍然留档，事件里记一条 snapshot_degraded。
SNAPSHOT_MAX_ATTEMPTS=3                # 最多重抓几次（1 = 关掉重抓）
SNAPSHOT_MIN_DETAIL=1.0                # 画面纵向细节度下限；0 = 关掉这项体检
                                       # 实测真机全景正常 2.58–3.84、损坏 0.17、全糊 0.00
                                       # 场景本来就极平坦的现场（如空白灰墙的仿真）可调低或设 0
