# 拷成 config/.env 后填写。config/.env 已被 .gitignore 排除，别提交它。
# 云端（真机）
CX_HOST=https://certaintyx.sg:8443
CX_ROBOT=ntu-dog-00001                # 机器人别名，不是机器人 ID
CX_KEY=cx_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# mock 网关（开发/测试）：把上面三行换成下面三行
# CX_HOST=http://127.0.0.1:18443
# CX_ROBOT=ntu-dog-00001
# CX_KEY=cx_mock0001_000000000000000000000000000000000000000000000000

# 本系统
PS_HOST=127.0.0.1
PS_PORT=8088
PS_DATA_DIR=./data
PS_DB_PATH=./data/scheduler.db

# VLM（也可在网页「设置」里改，设置表优先）
VLM_PROVIDER=mock                     # mock | openai_compat | anthropic
VLM_BASE_URL=http://127.0.0.1:11434/v1
VLM_MODEL=qwen2.5vl:7b
VLM_API_KEY=
ANTHROPIC_API_KEY=

# TTS
TTS_ENGINE=edge                       # edge | command | none
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_SINKS=browser                     # 逗号分隔：browser,local,http,webhook
TTS_AUDIO_SERVER_URL=                 # 机器狗/现场 PC 上的 audio_server，如 http://192.168.0.122:5566
TTS_AUDIO_SERVER_TOKEN=
TTS_WEBHOOK_URL=

# 抓图源：rtsp（真机）| synthetic（mock/无相机）| file:<path>
SNAPSHOT_SOURCE=synthetic
